// =====================================================================================
// measures.dax  |  Power Pivot / Tabular model for the Financial Analytics & Risk Reporting System
//
// STATUS: written against the schema in sql/01_ddl.sql. NOT EXECUTED in the build sandbox (no Excel / Power BI
//         engine available). The SQL these measures sit on IS executed and tested. Paste, then validate the
//         numbers against sql/02 views (v_pl_monthly, v_variance_analysis) - they must tie to the cent.
//
// MODEL
//   dim_date[Date]                 (mark as Date Table; one row per day)
//   dim_chart_of_accounts[account_id]  1--*  fact_general_ledger[account_id]
//   dim_chart_of_accounts[account_id]  1--*  fact_budget[account_id]
//   dim_department[department_id]      1--*  fact_general_ledger[department_id]  and  fact_budget[department_id]
//   dim_date[Date]  1--*  fact_general_ledger[posting_period]   (posting_period is always a month-start date)
//   dim_date[Date]  1--*  fact_budget[BudgetPeriod]             (calculated column below)
//   dim_date[Date]  1--*  fact_provisioning_ledger[as_of_date]  (month-end snapshot dates exist in dim_date)
//   dim_provision_basis                                         (DISCONNECTED - drives the toggle)
//   All relationships single-direction, dimension -> fact.
// =====================================================================================


// ---------- CALCULATED COLUMNS (add in the Power Pivot data view) ---------------------

// fact_general_ledger[Signed Amount]  - natural-sign amount; contra accounts (1210) handled via normal_balance
Signed Amount =
VAR nb = RELATED ( dim_chart_of_accounts[normal_balance] )
RETURN
    IF (
        nb = "D",
        fact_general_ledger[debit_amount] - fact_general_ledger[credit_amount],
        fact_general_ledger[credit_amount] - fact_general_ledger[debit_amount]
    )

// fact_budget[BudgetPeriod]  - month-start date used to relate budget to dim_date
BudgetPeriod = DATE ( fact_budget[fiscal_year], fact_budget[fiscal_period], 1 )


// ---------- 1. TOTAL ACTUAL AMOUNT ----------------------------------------------------
// Natural sign: Revenue positive when credits exceed debits; Expense positive when debits exceed credits.
// Meaningful per account / sub-category / account type. Do NOT add Revenue + Expense: use [Pre-Tax Income (GL)].
Total Actual Amount =
SUM ( fact_general_ledger[Signed Amount] )

// Measure-only equivalent (no calculated column; slower on large GL because it iterates rows):
Total Actual Amount (Iterator) =
SUMX (
    fact_general_ledger,
    IF (
        RELATED ( dim_chart_of_accounts[normal_balance] ) = "D",
        fact_general_ledger[debit_amount] - fact_general_ledger[credit_amount],
        fact_general_ledger[credit_amount] - fact_general_ledger[debit_amount]
    )
)


// ---------- 2. TOTAL BUDGET AMOUNT ----------------------------------------------------
// fact_budget is stored in NATURAL sign (revenue and expense both positive), matching [Total Actual Amount].
Total Budget Amount =
SUM ( fact_budget[budgeted_amount] )


// ---------- 3. BUDGET VARIANCE (direction-aware; positive = FAVOURABLE) ----------------
// Revenue: Actual - Budget.  Expense: Budget - Actual.  Balance-sheet accounts have no budget -> BLANK.
// Evaluated per account (context transition on VALUES) so mixed Revenue+Expense totals aggregate correctly.
Budget Variance =
SUMX (
    VALUES ( dim_chart_of_accounts[account_id] ),
    VAR acct = dim_chart_of_accounts[account_id]
    VAR acctType =
        LOOKUPVALUE ( dim_chart_of_accounts[account_type], dim_chart_of_accounts[account_id], acct )
    VAR act = [Total Actual Amount]
    VAR bud = [Total Budget Amount]
    RETURN
        SWITCH ( acctType, "Revenue", act - bud, "Expense", bud - act, BLANK () )
)

// Plain arithmetic variance exactly as written in the spec. Only meaningful when ONE account type is in context.
Raw Variance (Actual - Budget) =
[Total Actual Amount] - [Total Budget Amount]

// Budget base used as the % denominator: sum of |budget| across P&L accounts only (never nets Rev vs Exp).
Budget Base (P&L) =
SUMX (
    VALUES ( dim_chart_of_accounts[account_id] ),
    VAR acctType =
        LOOKUPVALUE ( dim_chart_of_accounts[account_type], dim_chart_of_accounts[account_id], dim_chart_of_accounts[account_id] )
    RETURN
        IF ( acctType IN { "Revenue", "Expense" }, ABS ( [Total Budget Amount] ), BLANK () )
)

Variance Flag =
VAR v = [Budget Variance]
RETURN IF ( ISBLANK ( v ), BLANK (), IF ( v < 0, "Unfavourable", IF ( v > 0, "Favourable", "On plan" ) ) )


// ---------- 4. VARIANCE % --------------------------------------------------------------
// = Budget Variance / Budget Base. DIVIDE() returns BLANK on a zero/blank denominator (no #DIV/0!).
// Deviation from the spec's  Variance / Budget : the denominator is ABS(budget) per account so the sign of the
// result always means favourable (+) / unfavourable (-), and Revenue and Expense budgets are never netted.
Variance % =
DIVIDE ( [Budget Variance], [Budget Base (P&L)] )


// ---------- 5. YEAR-TO-DATE ------------------------------------------------------------
// Fiscal year = calendar year in this build. For a March year-end use TOTALYTD ( ..., "3/31" )  (string uses the
// client locale's date order - test it). Requires dim_date marked as a Date Table with unbroken daily dates.
Actual YTD =
TOTALYTD ( [Total Actual Amount], dim_date[Date] )

Budget YTD =
TOTALYTD ( [Total Budget Amount], dim_date[Date] )

Budget Variance YTD =
CALCULATE ( [Budget Variance], DATESYTD ( dim_date[Date] ) )

Variance % YTD =
CALCULATE ( [Variance %], DATESYTD ( dim_date[Date] ) )

// Custom filter-context equivalent of TOTALYTD (use when the date table is non-standard):
Actual YTD (Custom) =
CALCULATE (
    [Total Actual Amount],
    FILTER (
        ALL ( dim_date ),
        dim_date[Year] = MAX ( dim_date[Year] ) && dim_date[Date] <= MAX ( dim_date[Date] )
    )
)

// 12-month trailing average (partial for the first 11 months, same as SQL v_pl_monthly):
Actual 12M Moving Avg =
AVERAGEX (
    DATESINPERIOD ( dim_date[month_start], MAX ( dim_date[month_start] ), -12, MONTH ),
    CALCULATE ( [Total Actual Amount] )
)


// ---------- P&L building blocks (account-level definitions mirror sql v_pl_monthly) ------
Gross Revenue =
CALCULATE ( [Total Actual Amount], dim_chart_of_accounts[account_type] = "Revenue" )

Interest Expense =
CALCULATE ( [Total Actual Amount], dim_chart_of_accounts[account_code] = "5000" )

Net Revenue =
[Gross Revenue] - [Interest Expense]

Booked Provision =
CALCULATE ( [Total Actual Amount], dim_chart_of_accounts[sub_category] = "Provision" )

Total P&L Expenses =
CALCULATE ( [Total Actual Amount], dim_chart_of_accounts[account_type] = "Expense" )

Operating Income =
[Gross Revenue] - ( [Total P&L Expenses] - [Booked Provision] )

// No tax accounts exist in the COA, so this is pre-tax = net income. Do not label it post-tax.
Pre-Tax Income (GL) =
[Gross Revenue] - [Total P&L Expenses]


// ---------- 6. DYNAMIC PROVISIONING ADJUSTMENT (Credit module -> P&L) -------------------
// Latest modelled-EL snapshot on or before the last visible date (snapshots are not monthly in general).
Modelled EL Balance =
VAR cutoff = MAX ( dim_date[Date] )
VAR lastSnap =
    CALCULATE (
        MAX ( fact_provisioning_ledger[as_of_date] ),
        REMOVEFILTERS ( dim_date ),
        fact_provisioning_ledger[as_of_date] <= cutoff
    )
RETURN
    IF (
        ISBLANK ( lastSnap ),
        BLANK (),
        CALCULATE (
            SUM ( fact_provisioning_ledger[expected_loss_amount] ),
            REMOVEFILTERS ( dim_date ),
            fact_provisioning_ledger[as_of_date] = lastSnap
        )
    )

// Charge needed to move the allowance from last month's modelled EL to this month's.
// BLANK (not the full balance) when there is no prior snapshot - otherwise month 1 would book the whole allowance.
// Ignores write-offs (allowance utilisation): see docs/limitations.md.
Modelled Provision Charge =
VAR cur = [Modelled EL Balance]
VAR prior = CALCULATE ( [Modelled EL Balance], PREVIOUSMONTH ( dim_date[Date] ) )
RETURN IF ( ISBLANK ( cur ) || ISBLANK ( prior ), BLANK (), cur - prior )

// Booked allowance balance (acct 1210, cumulative to the last visible date), natural (credit) sign.
Booked Allowance Balance =
CALCULATE (
    [Total Actual Amount],
    dim_chart_of_accounts[account_code] = "1210",
    FILTER ( ALL ( dim_date ), dim_date[Date] <= MAX ( dim_date[Date] ) )
)

Allowance Gap (Model - Booked) =
[Modelled EL Balance] - [Booked Allowance Balance]

// Toggle: slicer on dim_provision_basis[basis_name]. Defaults to Booked when nothing / both selected.
Provision Expense (Selected) =
IF (
    SELECTEDVALUE ( dim_provision_basis[basis_name], "Booked (GL)" ) = "Modelled (EL)",
    COALESCE ( [Modelled Provision Charge], [Booked Provision] ),   // falls back to booked if no model snapshot pair
    [Booked Provision]
)

Pre-Tax Income (Adjusted) =
[Pre-Tax Income (GL)] + [Booked Provision] - [Provision Expense (Selected)]

Provision Impact on Income =
[Pre-Tax Income (Adjusted)] - [Pre-Tax Income (GL)]
